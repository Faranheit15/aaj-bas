{
  "name": "aaj-bas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "bun run --filter @aaj-bas/landing dev",
    "dev:web": "bun run --filter @aaj-bas/web dev",
    "check:agents": "bash scripts/check-agents-md-size.sh",
    "check:pm": "bash scripts/check-package-manager.sh",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "lint": "bunx @biomejs/biome lint .",
    "typecheck": "bun run --filter @aaj-bas/* typecheck",
    "test": "bun run --filter @aaj-bas/landing --filter @aaj-bas/web test",
    "build": "bun run --filter @aaj-bas/landing build && bun run --filter @aaj-bas/web build",
    "check": "bun run check:agents && bun run check:pm && bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "typescript": "^5.9.0"
  }
}
