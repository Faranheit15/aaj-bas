{
  "name": "aaj-bas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:landing": "bun run --filter @aaj-bas/landing dev",
    "dev:web": "bun run --filter @aaj-bas/web dev",
    "check:agents": "bash scripts/check-agents-md-size.sh",
    "check:pm": "bash scripts/check-package-manager.sh",
    "format": "bunx @biomejs/biome format --write .",
    "format:check": "bunx @biomejs/biome format .",
    "lint": "bunx @biomejs/biome lint .",
    "typecheck": "bun run --filter @aaj-bas/* typecheck && bunx tsc --noEmit -p scripts/tsconfig.json && bunx tsc --noEmit -p apps/web/e2e/tsconfig.json",
    "content:validate": "bun scripts/validate-edition.ts",
    "content:stage": "bun scripts/stage-content.ts",
    "content:correct": "bun scripts/create-correction.ts",
    "status:generate": "bun scripts/generate-status-artifact.ts",
    "sources:validate": "bun scripts/validate-sources.ts",
    "sources:fetch": "bun scripts/fetch-sources.ts",
    "draft:generate": "bun scripts/generate-draft-edition.ts",
    "draft:pr": "bun scripts/open-daily-draft-pr.ts",
    "edition:publish": "bun scripts/publish-edition.ts",
    "edition:smoke": "bun scripts/smoke-test-edition.ts",
    "edition:rollback": "bun scripts/rollback-edition.ts",
    "golden:evaluate": "bun scripts/evaluate-golden-dataset.ts",
    "test:golden": "bun scripts/evaluate-golden-dataset.ts",
    "test": "bun run --filter @aaj-bas/* test",
    "e2e": "bun run --filter @aaj-bas/web e2e",
    "build": "bun run --filter @aaj-bas/landing build && bun run --filter @aaj-bas/web build",
    "check:security": "bun scripts/audit-security.ts",
    "check:perf": "bun scripts/check-performance-budget.ts",
    "check": "bun run check:agents && bun run check:pm && bun run check:security && bun run format:check && bun run lint && bun run typecheck && bun run content:validate && bun run sources:validate && bun run test && bun run build && bun run check:perf"
  },
  "devDependencies": {
    "@aaj-bas/domain": "workspace:*",
    "@aaj-bas/schemas": "workspace:*",
    "@biomejs/biome": "^2.5.8",
    "typescript": "^7.0.2"
  }
}
